# General configuration --------------------------------------------------------

# Writeable directory where all the files will be stored (default: ./data)
# NANIT_DATA_DIR=/app/data

# Default value: info
# Allowed values: trace | debug | info | warn | error | fatal | panic
# NANIT_LOG_LEVEL=debug

# Session file (optional)
# Stores state between runs, useful for rapid development so that we don't get
# flagged by auth. servers for too many requests during application re-runs.
#
# Warning: The file contains sensitive information (auth tokens, etc.).
#  It is recommended to only use it during development.
# NANIT_SESSION_FILE=data/session.json

# Nanit credentials ------------------------------------------------------------

# Nanit user credentials (as entered during Nanit cam registration)
NANIT_EMAIL=xxxx@xxxx.tld
NANIT_PASSWORD=xxxxxxxxxx

# RTMP server ------------------------------------------------------------------

# Enable integrated RTMP server (default: true)
# NANIT_RTMP_ENABLED=true

# Address under which is this app reachable from the cam
# Note: You cannot use your 127.0.0.1 here, it has to be reachable from the cam.
#  Also pay attention to the port if you are port forwarding it in Docker.
# NANIT_RTMP_ADDR=192.168.3.234:1935

# MQTT -------------------------------------------------------------------------

# Enable MQTT integration for reading sensors data (default: false)
# NANIT_MQTT_ENABLED=true

# MQTT broker host (required if enabled)
# Examples:
# - Plain TCP: tcp://iot.eclipse.org:1883
# - Websocket: ws://my.mqtt.local or wss://my.secure.mqtt.local
# NANIT_MQTT_BROKER_URL=

# Credentials for MQTT broker (optional)
# NANIT_MQTT_USERNAME=
# NANIT_MQTT_PASSWORD=

# Client ID (default: nanit)
# NANIT_MQTT_CLIENT_ID=mynanit

# Topic prefix (default: nanit)
# NANIT_MQTT_PREFIX=mynanit

# Event Polling ----------------------------------------------------------------

# While Nanit doesn't provide a stream of events to subscribe to, you can poll
# the /babies/{baby_uid}/messages endpoint to retrieve the latest event messages

# Enable events polling
# NANIT_EVENTS_POLLING=true

# Interval in seconds at which to poll for new event messages (default: 30)
# NANIT_EVENTS_POLLING_INTERVAL=20

# Time in seconds after which to disregard event messages (default: 300)
# NANIT_EVENTS_MESSAGE_TIMEOUT=300

# Activity list ----------------------------------------------------------------

# The Nanit app shows a list of events for a baby: motion, sound, "Baby fell
# asleep", "Baby woke up", "Parent took baby out" and so on. The Nanit service
# keeps this list whether or not the account gets notifications. With this
# setting the program asks for the list once a minute and publishes every new
# entry over MQTT (needs NANIT_MQTT_ENABLED). See docs/sensors.md.
#
# Follow the activity list (default: false)
# NANIT_ACTIVITY_POLLING=true

# Time in seconds between two requests for the list (default: 60, and 10 or
# more). The service sends some 5 kilobytes for each entry. One request asks
# for the 5 newest entries, and one request every 15 minutes for the newest
# 30: that is some 50 megabytes a day with the default, and some 150 with 15.
# The service adds the events about sleep about 15 minutes late whatever
# this is.
# NANIT_ACTIVITY_POLLING_INTERVAL=60

# Push notifications -----------------------------------------------------------

# The Nanit service sends push notifications to the phones with the Nanit
# app: motion, sound, a crying baby, temperature and humidity out of range,
# and whatever else the account is set to get. With this setting the program
# gets them too, within seconds. It registers as one more device with the
# Nanit app for Android, once, and keeps the registration in the session
# file. See docs/sensors.md for what it does with them.
#
# Enable the push notifications (default: false)
# NANIT_PUSH_ENABLED=true

# The API key of the Nanit app for Android at the Firebase service of
# Google, which delivers the notifications (required if enabled). It is
# part of the app, and not of this repository: an app that uses Firebase
# carries it in its resources as the string google_api_key.
# NANIT_PUSH_FIREBASE_API_KEY=

# Stream of the camera -----------------------------------------------------------

# Time in seconds without any packet of the camera after which its stream
# counts as ended and a new one is asked for (default: 30). A stream can stop
# without a sign, for example when the camera loses its network. A gap that
# is shorter passes with a picture that stands still. 0 turns this off.
# NANIT_RTMP_READ_TIMEOUT=30

# Websocket connection to the camera --------------------------------------------

# The camera is asked to stream through a websocket connection to the Nanit
# service. A connection can stop carrying data without any sign, for example
# when a router restarts. The program therefore sends a ping at an interval,
# and it makes the connection again when nothing has arrived for a while.

# Time in seconds between two pings (default: 20)
# NANIT_WS_PING_INTERVAL=20

# Time in seconds without any data after which the connection is made again
# (default: 70, or three times the ping interval if that is more). It must
# be at least two times the ping interval. 0 turns this off. The limit
# applies from the moment the service has answered a ping.
# NANIT_WS_IDLE_TIMEOUT=70

# Stop of the program ----------------------------------------------------------

# Time in seconds that the program takes at most to end in order when it is
# told to stop (default: 8). In that time it asks the camera to stop the
# stream, so that the camera has a free place for the next start at once.
# A container is killed 10 seconds after it was told to stop. If yours gets
# more time (stop_grace_period in a compose file), this can be raised too.
# NANIT_SHUTDOWN_TIMEOUT=8
